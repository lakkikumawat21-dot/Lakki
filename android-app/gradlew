#!/bin/sh

# Universal Gradle Wrapper Script for Hermes Agent
set -e

DIRNAME="$(dirname "$0")"
APP_DIR="$(cd "$DIRNAME" && pwd)"
WRAPPER_JAR="$APP_DIR/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading gradle-wrapper.jar..."
    mkdir -p "$APP_DIR/gradle/wrapper"
    curl -fsSL "https://raw.githubusercontent.com/gradle/gradle/v8.5.0/gradle/wrapper/gradle-wrapper.jar" -o "$WRAPPER_JAR" || true
fi

if [ -f "$WRAPPER_JAR" ]; then
    exec java -cp "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
else
    if command -v gradle >/dev/null 2>&1; then
        exec gradle "$@"
    else
        echo "Error: Gradle wrapper jar could not be found or downloaded." >&2
        exit 1
    fi
fi
